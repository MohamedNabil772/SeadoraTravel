{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "SeadoraIdentity",
    "Audience": "SeadoraGateway",
    "Key": "SuperSecretKeyForSeadoraAdminPanel!"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "admin-content-import-route": {
        "ClusterId": "content-bulk-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/content/tours/import-translations"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/content" } ]
      },
      "admin-content-template-route": {
        "ClusterId": "content-bulk-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/content/tours/template"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/content" } ]
      },
      "admin-content-export-route": {
        "ClusterId": "content-bulk-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/content/tours/export/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/content" } ]
      },
      "admin-search-route": {
        "ClusterId": "content-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/search"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll"
      },
      "admin-content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/admin/content/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/content" } ]
      },
      "admin-booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/admin/booking/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/booking" } ]
      },
      "admin-identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/admin/identity/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/admin/identity" } ]
      },
      "admin-file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/admin/files/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminPolicy",
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathPattern": "/api/files/{**catch-all}" } ]
      },
      "identity-prefixed-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/api/{**catch-all}"
        },
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/auth" } ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "CorsPolicy": "AllowAll"
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/content/{**catch-all}"
        },
        "CorsPolicy": "AllowAll",
        "Transforms": [ { "PathRemovePrefix": "/api/content" } ]
      },
      "concierge-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/concierge/{**catch-all}"
        },
        "CorsPolicy": "AllowAll"
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/api/booking" } ]
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:8080"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://content-service:8080"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "content-bulk-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://content-service:8080"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:15:00"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://booking-service:8080"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://file-server:8080"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
